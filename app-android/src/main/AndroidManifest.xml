<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-test (PLAN S6): renders keep running with the screen off, with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".android.AutoFlowApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Auto Flow"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".android.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".android.selftest.SelfTestActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="false"
            android:label="Self-test"
            android:launchMode="singleTop" />
        <service
            android:name=".android.selftest.SelfTestService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>

</manifest>
